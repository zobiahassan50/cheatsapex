---
import {
  DEFAULT_LOCALE,
  getLocaleFromPathname,
  stripLocalePrefix,
  useTranslations,
  withLocalePrefix,
} from '../i18n';
import { checkoutPath } from '../config/checkout';
import { Button } from '@/components/starwind/button';
import AnimatedThemeSwitch from './AnimatedThemeSwitch.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import {
  Sheet,
  SheetContent,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from '@/components/starwind/sheet';
import Icon from './icons/Icon.astro';
import SlideRevealButton from './SlideRevealButton.astro';

import type { IconName } from './icons/types';

const locale = Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname) ?? DEFAULT_LOCALE;
const t = useTranslations(locale);
const homeHref = withLocalePrefix('/', locale);

const navIconsByPath: Record<string, IconName> = {
  '/products/apex-cheats/': 'navProducts',
  '/blog/': 'navBlog',
  '/forum/': 'messageCircle',
  '/faq/': 'navFaq',
  '/support/': 'navSupport',
};

const purchaseUrl = checkoutPath('apex');
---

<header class="relative isolate">
  <div class="flex justify-center px-3 pt-3 sm:px-4 sm:pt-4" data-floating-nav>
    <div
      class="relative flex h-14 w-full max-w-6xl items-center justify-between gap-3 overflow-visible rounded-2xl border border-border/40 bg-background/35 pl-4 pr-3 text-foreground shadow-md shadow-black/5 backdrop-blur-2xl supports-[backdrop-filter]:bg-background/25 dark:border-white/10 dark:bg-background/20 dark:shadow-black/25 sm:pl-5 sm:pr-3.5 lg:h-[3.75rem]"
    >
    <a href={homeHref} class="inline-flex min-w-0 items-center font-[family-name:var(--font-heading)] text-lg font-bold tracking-wide" aria-label={t.ui.homeAria}>
      <span class="truncate" aria-hidden="true">Apex<span class="text-primary">Cheats</span></span>
    </a>

    <nav class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-5 xl:gap-6 lg:flex" aria-label="Primary">
      {t.nav.map((link) => (
        <a
          href={link.href}
          class="nav-link inline-flex items-center gap-1.5 whitespace-nowrap text-sm font-medium text-muted-foreground transition-colors hover:text-primary"
          data-nav-link
          {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
        >
          <Icon name={navIconsByPath[stripLocalePrefix(link.href)] ?? 'navFeatures'} size={16} />
          {link.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-2 sm:gap-2.5">
      <div class="flex items-center gap-2 sm:ml-2 lg:ml-4">
        <LanguageSwitcher idSuffix="desktop" />
        <SlideRevealButton href={purchaseUrl} class="hidden lg:inline-flex" ariaLabel={t.ui.checkoutAria}>
          {t.ui.browseCheats}
        </SlideRevealButton>
      </div>
      <AnimatedThemeSwitch
        size="sm"
        ariaLabel={t.ui.themeLight}
        class="hidden sm:inline-flex"
      />

      <Sheet class="lg:hidden">
        <SheetTrigger
          class="inline-flex size-9 items-center justify-center rounded-lg border border-border/80 bg-background/50 text-foreground transition-colors hover:bg-muted lg:hidden"
          aria-label={t.ui.menuOpen}
        >
          <Icon name="menu" size={20} />
        </SheetTrigger>
        <SheetContent side="right" class="flex w-[min(100vw-2rem,20rem)] flex-col gap-4">
          <SheetHeader>
            <SheetTitle>{t.site.name}</SheetTitle>
          </SheetHeader>
          <LanguageSwitcher idSuffix="mobile" />
          <nav class="flex flex-col gap-1" aria-label="Mobile">
            {t.nav.map((link) => (
              <a
                href={link.href}
                class="nav-link flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-primary"
                data-nav-link
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
              >
                <Icon name={navIconsByPath[stripLocalePrefix(link.href)] ?? 'navFeatures'} size={16} />
                {link.label}
              </a>
            ))}
          </nav>
          <Button as="a" href={purchaseUrl} variant="primary" class="w-full justify-center" aria-label={t.ui.checkoutAria}>
            {t.ui.browseCheatsMobile}
          </Button>
          <div class="flex justify-center pt-1">
            <AnimatedThemeSwitch size="sm" ariaLabel={t.ui.themeLight} />
          </div>
        </SheetContent>
      </Sheet>
    </div>
    </div>
  </div>
</header>
