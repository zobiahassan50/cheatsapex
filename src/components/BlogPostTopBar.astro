---
import Icon from './icons/Icon.astro';
import { ROUTES } from '../utils/path';
import { blogTagIcons } from '../data/sectionIcons';
import type { BlogPost } from '../i18n/types';
import type { IconName } from './icons/types';
import { Badge } from '@/components/starwind/badge';
import {
  DEFAULT_LOCALE,
  getLocaleFromPathname,
  localizeHref,
  useTranslations,
} from '../i18n';

interface Props {
  post: BlogPost;
  class?: string;
}

const locale = Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname) ?? DEFAULT_LOCALE;
const t = useTranslations(locale);
const { post, class: className } = Astro.props;
const tagIcon: IconName = blogTagIcons[post.tag] ?? 'tag';
const blogHref = localizeHref(ROUTES.blog, locale);
---

<div class:list={['blog-article__toolbar', className]}>
  <a href={blogHref} class="blog-article__toolbar-back shrink-0">
    <Icon name="chevronLeft" size={15} aria-hidden="true" />
    {t.blog.allArticles}
  </a>
  <div class="blog-article__toolbar-meta min-w-0">
    <Badge variant="secondary" size="sm" class="blog-article__toolbar-badge max-w-[min(9rem,40vw)] gap-1 rounded-full" title={post.tag}>
      <Icon name={tagIcon} size={12} class="shrink-0" />
      <span class="truncate">{post.tag}</span>
    </Badge>
    <Badge variant="outline" size="sm" class="blog-article__toolbar-badge max-w-[min(8rem,36vw)] gap-1 rounded-full" title={post.readTime}>
      <Icon name="clock" size={12} class="shrink-0" />
      <span class="truncate">{post.readTime}</span>
    </Badge>
    <Badge variant="outline" size="sm" class="blog-article__toolbar-badge max-w-[min(9rem,40vw)] gap-1 rounded-full" title={post.date}>
      <Icon name="calendar" size={12} class="shrink-0" />
      <span class="truncate">{post.date}</span>
    </Badge>
  </div>
</div>
