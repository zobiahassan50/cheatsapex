---
/**
 * Reusable JSON-LD injector for Article, FAQ, Breadcrumb, and @graph payloads.
 * Uses is:inline so the script is not processed/bundled by Vite.
 */
interface Props {
  data: Record<string, unknown> | Record<string, unknown>[];
}

const { data } = Astro.props;
const graphs = Array.isArray(data) ? data : [data];
const payload =
  graphs.length === 1
    ? graphs[0]
    : {
        '@context': 'https://schema.org',
        '@graph': graphs.map((entry) => {
          const { '@context': _ignored, ...rest } = entry;
          return rest;
        }),
      };

const json = JSON.stringify(payload).replace(/</g, '\\u003c');
---

<script type="application/ld+json" is:inline set:html={json} />
