---
/**
 * LCP hero poster + background via Astro assets Picture (sharp).
 * Widths/sizes map to real display slots; quality 75 for bytes without visible UI change.
 */
import { Picture } from 'astro:assets';
import posterSrc from '../assets/hero/apex-hero-poster.jpg';
import heroBgSrc from '../assets/hero/hero-apex.jpg';

interface Props {
  variant: 'poster' | 'background';
}

const { variant } = Astro.props;

/** ~720 CSS px poster slot; 360 for narrow phones, 960 for 2x desktop. */
const posterSizes = '(min-width: 1024px) 32rem, (min-width: 640px) 70vw, calc(100vw - 2.5rem)';
const bgSizes = '(min-width: 1600px) 1920px, (min-width: 768px) 1280px, 100vw';
---

{
  variant === 'poster' ? (
    <Picture
      src={posterSrc}
      formats={['webp']}
      widths={[360, 720, 960]}
      sizes={posterSizes}
      quality={75}
      width={720}
      height={405}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="aspect-video h-auto w-full object-cover"
    />
  ) : (
    <Picture
      src={heroBgSrc}
      formats={['webp']}
      widths={[640, 960, 1280, 1920]}
      sizes={bgSizes}
      quality={75}
      width={1280}
      height={715}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 !h-full !max-h-none !w-full !max-w-none object-cover brightness-[0.85] dark:brightness-[0.4]"
    />
  )
}
