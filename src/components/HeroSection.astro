---
import { DEFAULT_LOCALE, getLocaleFromPathname, useTranslations, withLocalePrefix } from '../i18n';
import { ROUTES } from '../utils/path';
import { compatibilityIcons, heroStatIcons, heroStatusPills } from '../data/sectionIcons';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { Badge } from '@/components/starwind/badge';

const locale = Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname) ?? DEFAULT_LOCALE;
const t = useTranslations(locale);
const h = t.hero;
const productsHref = withLocalePrefix(ROUTES.products ?? '/products/apex-cheats/', locale);
/** Display ~510–620px → 960w covers 2x; avoid shipping 1280 poster as LCP. */
const heroPosterDefault = '/videos/apex-hero-poster-960.webp';
const heroPosterSrcset =
  '/videos/apex-hero-poster-640.webp 640w, /videos/apex-hero-poster-960.webp 960w, /videos/apex-hero-poster-1280.webp 1280w';
const heroPosterSizes = '(min-width: 1024px) 32rem, (min-width: 640px) 70vw, calc(100vw - 2.5rem)';
const heroBgDefault = '/images/hero-apex-1280.webp';
const heroBgSrcset =
  '/images/hero-apex-640.webp 640w, /images/hero-apex-960.webp 960w, /images/hero-apex-1280.webp 1280w, /images/hero-apex-1920.webp 1920w';
/** Prefer 1280 for typical desktop widths so we don't pull 1920 for ~1500 CSS px. */
const heroBgSizes = '(min-width: 1600px) 1920px, 1280px';

const heroMarqueePills = [
  ...heroStatusPills,
  ...t.compatibility.items.map((label, i) => ({
    label,
    icon: compatibilityIcons[i] ?? 'check',
  })),
];

---

<section
  id="hero"
  class="relative overflow-hidden border-b border-border bg-background dark:bg-neutral-950"
  aria-labelledby="hero-title"
>
  <div class="pointer-events-none absolute inset-0 overflow-hidden [&>picture]:contents" aria-hidden="true">
    <picture>
      <source type="image/webp" srcset={heroBgSrcset} sizes={heroBgSizes} />
      <img
        src={heroBgDefault}
        srcset={heroBgSrcset}
        sizes={heroBgSizes}
        alt=""
        width="1280"
        height="715"
        loading="eager"
        decoding="async"
        fetchpriority="low"
        class="absolute inset-0 h-full w-full object-cover brightness-[0.85] dark:brightness-[0.4]"
      />
    </picture>
  </div>
  <div class="pointer-events-none absolute inset-0 bg-white/80 dark:bg-black/55" aria-hidden="true" />
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,#2d6ee2_0%,transparent_55%)] opacity-15 dark:opacity-25"
    aria-hidden="true"
  />
  <div class="pointer-events-none absolute inset-0 hero-bg-blue-tint" aria-hidden="true" />

  <div class="relative mx-auto flex max-w-6xl flex-col justify-center px-5">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div class="w-full max-w-xl space-y-6 text-left md:space-y-7 lg:max-w-2xl">
        <Badge variant="secondary" class="uppercase tracking-wider">{h.eyebrow}</Badge>

        <h1 id="hero-title" class="text-3xl font-bold leading-tight tracking-tight md:text-4xl lg:text-5xl">
          <span class="block text-foreground">{h.titleLine1}</span>
          <span class="block text-primary">{h.titleLine2}</span>
        </h1>

        <p class="max-w-xl text-sm leading-relaxed text-neutral-800 dark:text-neutral-400 md:text-base">
          {h.subtitle}
        </p>

        <div class="flex flex-wrap justify-start gap-3 sm:gap-4">
          <Button
            as="a"
            href={productsHref}
            data-scroll-target="products"
            variant="primary"
            size="lg"
            class="rounded-xl"
          >
            {h.ctaPrimary}
            <Icon name="arrowRight" size={18} />
          </Button>
          <Button
            as="a"
            href={t.site.discord}
            variant="secondary"
            size="lg"
            class="rounded-xl"
          >
            <Icon name="messageCircle" size={18} />
            {h.ctaDiscord}
          </Button>
        </div>
      </div>

      <div class="mx-auto flex w-full max-w-xl flex-col items-center gap-5 lg:mx-0 lg:max-w-none lg:items-end">
        <div
          class="relative w-full overflow-hidden rounded-xl border border-border bg-card p-2 shadow-sm"
          data-hero-video-wrap
        >
          {/* Responsive poster is LCP — video src injected later (one format only). */}
          <picture
            data-hero-poster
            class="pointer-events-none absolute inset-2 z-[1] overflow-hidden rounded-lg"
          >
            <source type="image/webp" srcset={heroPosterSrcset} sizes={heroPosterSizes} />
            <img
              src={heroPosterDefault}
              srcset={heroPosterSrcset}
              sizes={heroPosterSizes}
              alt=""
              width="960"
              height="540"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              class="aspect-video h-auto w-full object-cover"
            />
          </picture>
          <video
            class="relative z-0 aspect-video h-auto w-full rounded-lg object-cover"
            muted
            loop
            playsinline
            preload="none"
            data-hero-video
            aria-label="Apex Legends cheat gameplay preview"
          >
            <track
              kind="captions"
              srclang="en"
              label="English"
              src="/videos/apex-hero-captions.vtt"
              default
            />
          </video>
        </div>
        <div class="grid w-full grid-cols-2 gap-2.5 sm:gap-3 md:grid-cols-4 lg:grid-cols-2">
          {h.metrics.map((m, i) => (
            <div class="flex min-w-0 items-center gap-3 rounded-xl border border-primary/20 bg-card px-3 py-3 shadow-sm shadow-black/10 backdrop-blur-sm transition-colors hover:border-primary/50">
              <span
                class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-[#2d6ee2]/20 ring-1 ring-inset ring-[#2d6ee2]/40 text-primary"
                aria-hidden="true"
              >
                <Icon name={heroStatIcons[i] ?? 'check'} size={18} class="text-primary" />
              </span>
              <div class="min-w-0">
                <p class="font-[family-name:var(--font-heading)] text-base font-bold leading-none tracking-tight text-foreground">{m.strong}</p>
                <p class="mt-1 text-xs leading-tight text-muted-foreground">{m.label}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="hero-status-marquee relative mt-10 md:mt-12 lg:mt-14" aria-label="Features and platform support">
      <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 bg-gradient-to-r from-background to-transparent" aria-hidden="true" />
      <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 bg-gradient-to-l from-background to-transparent" aria-hidden="true" />
      <div class="hero-status-marquee-track flex w-max gap-2">
        {[...heroMarqueePills, ...heroMarqueePills].map((pill) => (
          <Badge variant="outline" class="group/badge shrink-0 gap-1 py-0.5 pl-1.5 pr-2.5 text-xs whitespace-nowrap">
            <Icon name={pill.icon} size={13} />
            {pill.label}
          </Badge>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function hydrateHeroVideos() {
    document.querySelectorAll<HTMLVideoElement>('video[data-hero-video]').forEach((video) => {
      if (video.dataset.hydrated === '1') return;
      video.dataset.hydrated = '1';

      const wrap = video.closest('[data-hero-video-wrap]');
      const poster = wrap?.querySelector<HTMLElement>('[data-hero-poster]');

      const hidePoster = () => {
        if (poster) poster.style.opacity = '0';
      };

      const start = () => {
        if (video.querySelector('source[data-hero-src]')) {
          void video.play().then(hidePoster).catch(() => {});
          return;
        }

        // ONE format only. MP4 is smaller here (~2.1MB) than WebM (~3.5MB) at equal quality.
        const source = document.createElement('source');
        source.dataset.heroSrc = '1';
        source.src = '/videos/apex-hero.mp4';
        source.type = 'video/mp4';
        video.appendChild(source);
        video.addEventListener('playing', hidePoster, { once: true });
        video.load();
        void video.play().then(hidePoster).catch(() => {});
      };

      const whenIdle = (cb: () => void) => {
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(cb, { timeout: 4000 });
        } else {
          window.setTimeout(cb, 2000);
        }
      };

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            if (!entries.some((e) => e.isIntersecting)) return;
            io.disconnect();
            whenIdle(start);
          },
          { rootMargin: '80px' },
        );
        io.observe(video);
      } else {
        whenIdle(start);
      }
    });
  }

  hydrateHeroVideos();
  document.addEventListener('astro:after-swap', hydrateHeroVideos);
</script>

<style>
  [data-hero-poster] {
    transition: opacity 0.35s ease;
  }
</style>
