---
/**
 * Astro Picture wrapper — AVIF + WebP srcset from src/assets via imageRegistry.
 * Falls back to a plain <img> for SVG / unresolved paths.
 */
import { Picture } from 'astro:assets';
import { DEFAULT_IMAGE_WIDTHS } from '../utils/responsiveImage';
import { resolveLocalImage } from '../utils/imageRegistry';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  loading?: 'lazy' | 'eager';
  fetchPriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  widths?: readonly number[];
  class?: string;
  desktopOnly?: boolean;
  quality?: number;
}

const {
  src,
  alt,
  width,
  height,
  loading = 'lazy',
  fetchPriority,
  sizes = '(min-width: 1024px) 640px, 100vw',
  widths = DEFAULT_IMAGE_WIDTHS,
  class: className,
  desktopOnly = false,
  quality = 75,
} = Astro.props;

const meta = resolveLocalImage(src);
const pictureSizes = desktopOnly ? '(min-width: 1024px) 490px, 1px' : sizes;
const widthList = [...widths];
---

{
  meta ? (
    <Picture
      src={meta}
      formats={['avif', 'webp']}
      widths={widthList}
      sizes={pictureSizes}
      width={width}
      height={height}
      alt={alt}
      loading={loading}
      decoding="async"
      fetchpriority={fetchPriority}
      quality={quality}
      class={className}
    />
  ) : (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
      fetchpriority={fetchPriority}
      class={className}
    />
  )
}
