---
import {
  DEFAULT_LOCALE,
  getLocaleFromPathname,
  localizeHref,
  useTranslations,
  withLocalePrefix,
} from '../i18n';
import { Separator } from '@/components/starwind/separator';

const locale = Astro.locals.locale ?? getLocaleFromPathname(Astro.url.pathname) ?? DEFAULT_LOCALE;
const t = useTranslations(locale);
const homeHref = withLocalePrefix('/', locale);

const resourceLinks = [
  {
    href: localizeHref('/blog/', locale),
    label: t.nav.find((l) => l.href.includes('/blog'))?.label ?? 'Blog',
    ariaLabel: 'Blog',
  },
  {
    href: localizeHref('/products/apex-cheats/apex-elite/', locale),
    label: 'Elite',
    ariaLabel: 'Elite',
  },
  {
    href: localizeHref('/products/apex-cheats/', locale),
    label: t.nav.find((l) => l.href.includes('/products'))?.label ?? 'Products',
    ariaLabel: 'Products',
  },
  { href: localizeHref('/support/', locale), label: t.footer.support },
];

const legalLinks = [
  { href: localizeHref('/about/', locale), label: t.footer.about },
  { href: localizeHref('/privacy/', locale), label: t.footer.privacy },
  { href: localizeHref('/terms/', locale), label: t.footer.terms },
];
---

<footer class="border-t border-border bg-muted/30 py-16">
  <div class="mx-auto max-w-6xl px-5">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <a href={homeHref} class="inline-flex items-center gap-2.5 font-[family-name:var(--font-heading)] text-lg font-bold" aria-label={t.ui.homeAria}>
          <img src="/logo.svg" alt="" width="32" height="32" class="rounded-md" />
          <span aria-hidden="true">Apex<span class="text-primary">Cheats</span></span>
        </a>
        <p class="text-sm text-muted-foreground">{t.footer.tagline}</p>
      </div>

      <nav aria-label={t.footer.explore}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.explore}</p>
        <ul class="mt-3 space-y-2">
          {t.footer.exploreLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-muted-foreground hover:text-primary"
                aria-label={link.ariaLabel}
                {...(link.scrollTarget ? { 'data-scroll-target': link.scrollTarget } : {})}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.support}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.support}</p>
        <ul class="mt-3 space-y-2">
          {resourceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-primary" aria-label={link.ariaLabel}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t.footer.legal}>
        <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{t.footer.legal}</p>
        <ul class="mt-3 space-y-2">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-muted-foreground hover:text-primary">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <Separator class="my-8" />
    <p class="text-center text-xs text-muted-foreground">
      © {new Date().getFullYear()} {t.site.name} · {t.site.domain}
    </p>
  </div>
</footer>
