---
import type { HTMLAttributes } from 'astro/types';
import { accordionContent } from './variants';

type Props = HTMLAttributes<'div'>;

const { class: className, style, ...rest } = Astro.props;
const panelStyle = ['animation: none', style].filter(Boolean).join('; ');
---

<div
  class={accordionContent({ class: className })}
  data-sw-accordion-content
  data-state="closed"
  data-slot="accordion-content"
  hidden
  style={panelStyle}
  {...rest}
>
  <slot />
</div>
