---
interface Props {
  class?: string;
  ariaLabel?: string;
  size?: 'default' | 'sm' | 'md';
}

const { class: className, ariaLabel = 'Toggle light and dark mode', size = 'default' } = Astro.props;
---

<label
  class:list={[
    'theme-mode-switch',
    size === 'sm' && 'theme-mode-switch--sm',
    size === 'md' && 'theme-mode-switch--md',
    className,
  ]}
>
  <input
    type="checkbox"
    aria-label={ariaLabel}
    data-sw-theme-control
    data-theme-on="dark"
    data-theme-off="light"
  />
  <span class="theme-mode-switch__slider" aria-hidden="true"></span>
</label>

<script>
  async function setupThemeController() {
    const { initThemeController } = await import('@starwind-ui/astro/theme');
    initThemeController();
  }

  function scheduleThemeController() {
    const run = () => {
      void setupThemeController();
    };
    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(run, { timeout: 2000 });
    } else {
      window.setTimeout(run, 1);
    }
  }

  scheduleThemeController();
  document.addEventListener('astro:after-swap', scheduleThemeController);
  document.addEventListener('starwind:init', scheduleThemeController);
</script>
