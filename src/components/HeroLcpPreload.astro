---
/** Preload LCP poster (high) + hero BG (low — CSS bg, must not compete with LCP). */
import { getImage } from 'astro:assets';
import posterSrc from '../assets/hero/apex-hero-poster.jpg';
import heroBgSrc from '../assets/hero/hero-apex.jpg';

const poster360 = await getImage({
  src: posterSrc,
  width: 360,
  format: 'webp',
  quality: 65,
});
const poster540 = await getImage({
  src: posterSrc,
  width: 540,
  format: 'webp',
  quality: 65,
});
const poster720 = await getImage({
  src: posterSrc,
  width: 720,
  format: 'webp',
  quality: 65,
});
const bg640 = await getImage({
  src: heroBgSrc,
  width: 640,
  format: 'webp',
  quality: 55,
});

const posterSrcset = `${poster360.src} 360w, ${poster540.src} 540w, ${poster720.src} 720w`;
const posterSizes = '(min-width: 1024px) 32rem, (min-width: 640px) 70vw, calc(100vw - 2.5rem)';
---

<link
  rel="preload"
  as="image"
  type="image/webp"
  href={poster540.src}
  imagesrcset={posterSrcset}
  imagesizes={posterSizes}
  fetchpriority="high"
/>
{/* Low priority — fills hero atmosphere after LCP poster paints */}
<link rel="preload" as="image" type="image/webp" href={bg640.src} fetchpriority="low" />
