---
/** Preload LCP poster that matches HeroLcpPicture (AVIF preferred, WebP fallback). */
import { getImage } from 'astro:assets';
import posterSrc from '../assets/hero/apex-hero-poster.jpg';
import heroBgSrc from '../assets/hero/hero-apex.jpg';

const poster620 = await getImage({
  src: posterSrc,
  width: 620,
  format: 'avif',
  quality: 90,
});
const poster960 = await getImage({
  src: posterSrc,
  width: 960,
  format: 'avif',
  quality: 90,
});
const poster1240 = await getImage({
  src: posterSrc,
  width: 1240,
  format: 'avif',
  quality: 90,
});
const poster960Webp = await getImage({
  src: posterSrc,
  width: 960,
  format: 'webp',
  quality: 90,
});
const bg1280 = await getImage({
  src: heroBgSrc,
  width: 1280,
  format: 'avif',
  quality: 90,
});
const bg1920 = await getImage({
  src: heroBgSrc,
  width: 1920,
  format: 'avif',
  quality: 90,
});

const posterSrcset = `${poster620.src} 620w, ${poster960.src} 960w, ${poster1240.src} 1240w`;
const posterSizes = '(min-width: 1024px) 32rem, (min-width: 640px) 70vw, calc(100vw - 2.5rem)';
const bgSrcset = `${bg1280.src} 1280w, ${bg1920.src} 1920w`;
---

<link
  rel="preload"
  as="image"
  type="image/avif"
  href={poster960.src}
  imagesrcset={posterSrcset}
  imagesizes={posterSizes}
  fetchpriority="high"
/>
<link
  rel="preload"
  as="image"
  type="image/webp"
  href={poster960Webp.src}
  fetchpriority="high"
/>
<link
  rel="preload"
  as="image"
  type="image/avif"
  href={bg1280.src}
  imagesrcset={bgSrcset}
  imagesizes="(min-width: 1600px) 1920px, 1280px"
/>
