---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n';
import { langStaticPaths } from '../../i18n/routing';
import { isLocaleCode, type LocaleCode } from '../../i18n/locales';
import { withLocalePrefix } from '../../i18n/utils';
import { breadcrumbSchema, faqPageSchema, webPageSchema } from '../../utils/schema';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SiteFaqSection from '../../components/SiteFaqSection.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import type { SiteFaqItem } from '../../data/faq';

export function getStaticPaths() {
  return langStaticPaths('faq');
}

const langParam = Astro.params.lang;
if (!langParam || !isLocaleCode(langParam) || langParam === 'en') {
  return Astro.redirect('/faq/');
}

const locale = langParam as LocaleCode;
Astro.locals.locale = locale;
const t = useTranslations(locale);
const faqPath = withLocalePrefix('/faq/', locale);
const breadcrumbs = [
  { name: t.ui.home, path: withLocalePrefix('/', locale) },
  { name: t.nav.find((n) => n.href.includes('/faq'))?.label ?? 'FAQ', path: faqPath },
];

/** Prefer locale FAQ overlay (t.faq.items) over English data/faq.ts. */
const faqs: SiteFaqItem[] = t.faq.items.map((item, i) => ({
  id: `locale-faq-${i + 1}`,
  topic: 'plans',
  icon: 'navFaq',
  q: item.q,
  a: item.a,
}));
---

<BaseLayout
  title={t.faq.title}
  description={t.faq.subtitle}
  jsonLd={[
    webPageSchema({
      name: t.faq.title,
      description: t.faq.subtitle,
      url: faqPath,
    }),
    faqPageSchema(
      faqs.map((f, i) => ({
        num: String(i + 1).padStart(2, '0'),
        q: f.q,
        a: f.a.replace(/<[^>]+>/g, ''),
      })),
    ),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-6">
        <SectionHeader
          eyebrow={t.faq.eyebrow}
          title={t.faq.title}
          desc={t.faq.subtitle}
          titleId="faq-page-title"
          level={1}
        />
      </div>
    </div>
  </section>

  <SiteFaqSection
    items={faqs}
    variant="full"
    titleId="faq-page-list"
    eyebrow={t.faq.eyebrow}
    title={t.faq.title}
    subtitle={t.faq.subtitle}
  />
</BaseLayout>
