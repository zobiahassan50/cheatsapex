---
import '../../../../styles/product-cheat-page.css';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { productHub, productPages } from '../../../../data/products';
import { getApexProductShowcase } from '../../../../data/productShowcase';
import { useTranslations } from '../../../../i18n';
import { langStaticPaths } from '../../../../i18n/routing';
import { isLocaleCode, type LocaleCode } from '../../../../i18n/locales';
import { withLocalePrefix } from '../../../../i18n/utils';
import { breadcrumbSchema, collectionPageSchema, itemListSchema } from '../../../../utils/schema';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import ProductShowcase from '../../../../components/ProductShowcase.astro';
import ProductHubExtras from '../../../../components/ProductHubExtras.astro';
import { productPath } from '../../../../utils/path';

export function getStaticPaths() {
  return langStaticPaths('products-hub');
}

const langParam = Astro.params.lang;
if (!langParam || !isLocaleCode(langParam) || langParam === 'en') {
  return Astro.redirect('/products/apex-cheats/');
}

const locale = langParam as LocaleCode;
Astro.locals.locale = locale;
const t = useTranslations(locale);
const showcase = getApexProductShowcase(locale);
const hubPath = withLocalePrefix(productHub.path, locale);
const breadcrumbs = [
  { name: 'Home', path: withLocalePrefix('/', locale) },
  { name: t.nav[0]?.label ?? 'Products', path: hubPath },
];
---

<BaseLayout
  title={t.products.title}
  description={t.products.subtitle}
  jsonLd={[
    collectionPageSchema({
      name: t.products.title,
      description: productHub.description,
      url: hubPath,
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(
      productPages.map((product) => ({
        name: product.title,
        url: withLocalePrefix(productPath(product.slug), locale),
      })),
    ),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-8">
        <ProductShowcase
          eyebrow={showcase.eyebrow}
          title={showcase.title}
          description={showcase.description}
          statusLabel={showcase.statusLabel}
          statusMeta={showcase.statusMeta}
          buyUrl={showcase.buyUrl}
          detailsUrl={showcase.detailsUrl}
          includedLabel={showcase.includedLabel}
          features={showcase.features}
          seoParagraphs={showcase.seoParagraphs}
        />
        <ProductHubExtras />
      </div>
    </div>
  </section>
</BaseLayout>
