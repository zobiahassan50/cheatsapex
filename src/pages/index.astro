---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import { faqPageSchema, organizationSchema, websiteSchema } from '../utils/schema';
import { getAllFaqs } from '../data/faq';
const seo = resolvePageSeo('/');
const homeFaqs = getAllFaqs();
/** LCP is the hero poster (video deferred). Match preload URL exactly — no extra full-size webp. */
const heroPoster = '/videos/apex-hero-poster.jpg';
const heroBgSrcset =
  '/images/hero-apex-640.webp 640w, /images/hero-apex-960.webp 960w, /images/hero-apex-1280.webp 1280w, /images/hero-apex-1920.webp 1920w';
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[websiteSchema(), organizationSchema(), faqPageSchema(homeFaqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') })))]}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroPoster}
    type="image/jpeg"
    fetchpriority="high"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    imagesrcset={heroBgSrcset}
    imagesizes="100vw"
  />
  <HeroSection />
  <FeaturesSection />
  <ProductsSection />
  <WhySetupSection />
  <ContentSections />
</BaseLayout>
